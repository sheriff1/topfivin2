{
  "name": "topfivin2",
  "version": "1.0.0",
  "description": "TopFivin2 - NBA Stats & Rankings Platform",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "backend/**/*.{js,cjs}": [
      "prettier --write",
      "pnpm --filter backend exec eslint --fix"
    ],
    "frontend/**/*.{js,jsx}": [
      "prettier --write",
      "pnpm --filter frontend exec eslint --fix"
    ],
    "frontend/**/*.{html,css}": "prettier --write",
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "pnpm": {
    "overrides": {
      "picomatch@2": ">=2.3.2",
      "picomatch@4": ">=4.0.4",
      "yaml@2": ">=2.8.3",
      "path-to-regexp": ">=8.4.0",
      "brace-expansion": ">=5.0.12",
      "lodash": ">=4.18.0",
      "js-yaml@3": ">=3.15.2 <4",
      "js-yaml@4": ">=4.3.2",
      "minimatch@10": ">=11.0.1",
      "ws@8": ">=8.21.0",
      "qs": ">=6.16.1",
      "form-data@4": ">=4.0.6",
      "browserslist": ">=4.28.7",
      "@humanfs/node": ">=0.16.8",
      "baseline-browser-mapping": ">=2.11.0"
    }
  }
}
