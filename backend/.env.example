# ──────────────────────────────────────────────────────────────────────────────
# NBA Stats Dashboard — Backend Environment
# Copy this file: cp backend/.env.example backend/.env
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# CORS origin for the frontend dev server
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Local development uses individual DB_* vars (no DATABASE_URL needed).
# Production (Neon) uses DATABASE_URL — set that in backend/.env.production
# (pipeline) and in the Render dashboard (API).
#
# macOS Homebrew: DB_USER must match your system username — run: whoami
# Linux / Docker: typically "postgres"
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_username
DB_PASSWORD=
DB_NAME=nba_stats

# ── App ───────────────────────────────────────────────────────────────────────
# The season is not configured: fetch derives it from the date (October rollover);
# every other step uses the latest season stored in the database.
# Backfill an old season with: make fetch SEASON=2024


# ── Error monitoring (optional) ───────────────────────────────────────────────
# Leave SENTRY_DSN empty to disable Sentry (the default locally). Set it in the
# Render dashboard for production.
SENTRY_DSN=
# Defaults to NODE_ENV. Use "production" on Render.
SENTRY_ENVIRONMENT=
